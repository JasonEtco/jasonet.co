---
layout: "layouts/_default.njk"
permalink: /cv/
title: CV
---
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap');
</style>

<main class="cv mx-auto max-w-3xl px-6 py-12 md:px-12 print:max-w-none print:p-0">
  <nav class="flex justify-between text-sm mb-10 print:hidden">
    <a class="text-gray-500" href="/">← jasonet.co</a>
    <a class="text-orange font-semibold" href="/cv.pdf" download>Download PDF</a>
  </nav>

  <header class="flex items-start justify-between mb-14 print:mb-7">
    <div class="flex items-stretch">
      <h1 class="cv-name">
        <span class="font-extrabold">{{ cv.name.first }}</span>
        <span class="font-light">{{ cv.name.last }}</span>
      </h1>
      <span class="cv-slash" aria-hidden="true"></span>
    </div>

    <ul class="text-right text-sm leading-relaxed list-none m-0 p-0">
      {%- for item in cv.contact %}
        <li>
          <a class="{% if item.highlight %}text-orange{% else %}text-gray-900{% endif %}" href="{{ item.url }}">{{ item.label }}</a>
        </li>
      {%- endfor %}
    </ul>
  </header>

  {%- if cv.summary %}
    <p class="cv-summary mb-12 print:mb-8 text-lg text-gray-700">
      {{ cv.summary | markdownInline | safe }}
    </p>
  {%- endif %}

  {%- for section in cv.sections %}
    {%- if not loop.first %}
      <div class="cv-divider md:ml-[37%] print:ml-[37%] my-10 print:my-4" aria-hidden="true"></div>
    {%- endif %}

    <section class="cv-section md:flex print:flex">
      <h2 class="cv-section-title md:w-[37%] print:w-[37%] flex-shrink-0 text-xl font-bold text-gray-900 mb-4 md:mb-0">
        {{ section.title }}
      </h2>

      <div class="flex-1">
        {%- for entry in section.entries %}
          {%- set compact = not entry.description and not entry.roles %}
          <article class="cv-entry {% if compact and not loop.last %}mb-1.5 print:mb-1{% else %}mb-6 print:mb-4{% endif %}">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-semibold text-gray-900">
                {{ entry.heading }}{% if entry.subheading %}<span class="font-normal text-gray-600">, {{ entry.subheading }}</span>{% endif %}
              </h3>
              {%- if entry.dates %}
                <span class="cv-dates">{{ entry.dates }}</span>
              {%- endif %}
            </div>

            {%- if entry.description %}
              <p class="text-gray-600">{{ entry.description | markdownInline | safe }}</p>
            {%- endif %}

            {%- for role in entry.roles %}
              <div class="cv-role {% if loop.first %}mt-1.5{% else %}mt-4 print:mt-2.5{% endif %}">
                <div class="flex items-baseline justify-between gap-4">
                  <h4 class="font-semibold text-gray-800">{{ role.title }}</h4>
                  <span class="cv-dates">{{ role.dates }}</span>
                </div>
                {%- if role.description %}
                  <p class="text-gray-600">{{ role.description | markdownInline | safe }}</p>
                {%- endif %}
                {%- if role.highlights %}
                  <ul class="cv-highlights">
                    {%- for item in role.highlights %}
                      <li>{{ item | markdownInline | safe }}</li>
                    {%- endfor %}
                  </ul>
                {%- endif %}
              </div>
            {%- endfor %}
          </article>
        {%- endfor %}
      </div>
    </section>
  {%- endfor %}
</main>
